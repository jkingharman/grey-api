{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bin/lint-hook",
            "timeout": 30,
            "statusMessage": "Linting"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bin/pr-open-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
