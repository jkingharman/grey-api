#!/usr/bin/env bash
# Run the API in the background for a Showboat demo. Fixed port and log path
# so exec lines in docs/demos/ replay identically on any machine
# (bin/showboat verify). 9393 so it never collides with a dev bin/server.
set -euo pipefail
cd "$(dirname "$0")/.."

PORT=9393
PID_FILE=tmp/demo-server.pid
LOG_FILE=tmp/demo-server.log

running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

start() {
  if running; then
    echo "demo server already running (pid $(cat "$PID_FILE"), port $PORT)"
    return
  fi
  mkdir -p tmp
  : >"$LOG_FILE"
  bin/server -p "$PORT" >"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"

  for _ in $(seq 1 100); do
    if curl -s -o /dev/null "http://localhost:$PORT/"; then
      echo "demo server listening on http://localhost:$PORT (log: $LOG_FILE)"
      return
    fi
    if ! running; then
      echo "demo server exited during boot; see $LOG_FILE" >&2
      exit 1
    fi
    sleep 0.2
  done
  echo "demo server did not answer on port $PORT within 20s; see $LOG_FILE" >&2
  exit 1
}

stop() {
  if ! running; then
    echo "demo server not running"
    rm -f "$PID_FILE"
    return
  fi
  kill "$(cat "$PID_FILE")"
  rm -f "$PID_FILE"
  echo "demo server stopped"
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  *)
    echo "usage: bin/demo-server start|stop" >&2
    exit 2
    ;;
esac
