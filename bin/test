#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

bundle check >/dev/null 2>&1 || bundle install

# DATABASE_URL is only needed by migrate and createdb; spec_helper derives
# its own from the same TestDatabase.url, so the two cannot drift.
db_url="$(ruby -r ./spec/support/test_database -e 'print TestDatabase.url')"
db_name="${db_url##*/}"
if ! psql -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='${db_name}'" | grep -q 1; then
  createdb "${db_name}"
fi

DATABASE_URL="$db_url" bundle exec rake db:migrate
exec bundle exec rspec "$@"
