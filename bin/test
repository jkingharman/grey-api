#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

bin/bootstrap

# DATABASE_URL is only needed by create and migrate; spec_helper derives
# its own from the same TestDatabase.url, so the two cannot drift.
db_url="$(ruby -r ./spec/support/test_database -e 'print TestDatabase.url')"
DATABASE_URL="$db_url" bundle exec rake db:create db:migrate
exec bundle exec rspec "$@"
