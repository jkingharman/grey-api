#!/usr/bin/env bash
# Boot the API. Sources .env if present; args pass through to rackup.
set -euo pipefail
cd "$(dirname "$0")/.."

bin/bootstrap
# Dev only: production gets its env from the platform and has no .env.
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

exec bundle exec rackup config.ru "$@"
